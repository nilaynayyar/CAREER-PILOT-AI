# ==============================================================================
# CareerPilot AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your local values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ML Subsystem Configuration
MODEL_DIR=ml/models
MODEL_ARTIFACT_NAME=final_model.joblib
MODEL_METADATA_NAME=model_metadata.json
RANDOM_SEED=42

# Google Gemini API (Free Tier) — Optional. System runs in fallback mode if empty.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_TIMEOUT_SECONDS=30

# Client API URLs (Optional — defaults to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
EXPO_PUBLIC_API_URL="http://127.0.0.1:8000"
CAREERPILOT_BACKEND_URL="http://127.0.0.1:8000"

